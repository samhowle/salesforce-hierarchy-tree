{
  "name": "salesforce-hierarchy-tree",
  "version": "0.1.0",
  "private": true,
  "description": "A generic Lightning Web Component that draws any self-referencing record hierarchy as a tree",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint force-app/main/default/lwc force-app/test",
    "test": "sfdx-lwc-jest --coverage",
    "test:watch": "sfdx-lwc-jest --watch",
    "format": "prettier --write \"force-app/**/*.{js,html,css,json}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"force-app/**/*.{js,html,css,json}\" \"*.{js,json}\""
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@lwc/eslint-plugin-lwc": "^3.5.0",
    "@salesforce/eslint-config-lwc": "^4.1.2",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "prettier": "^3.0.0"
  }
}
