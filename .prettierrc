{
  "useTabs": true,
  "tabWidth": 4,
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "none",
  "arrowParens": "avoid",
  "overrides": [
    {
      "files": [
        "**/lwc/**/*.html",
        "**/jest-mocks/**/*.html"
      ],
      "options": {
        "parser": "lwc"
      }
    },
    {
      "files": "*.{json,yml,yaml}",
      "options": {
        "useTabs": false,
        "tabWidth": 2
      }
    },
    {
      "files": "*.md",
      "options": {
        "useTabs": false,
        "tabWidth": 2,
        "proseWrap": "preserve"
      }
    }
  ]
}
